# Sao chép file này thành ".env" rồi điền thông tin Supabase của nhóm
# (Windows PowerShell: copy .env.example .env)

# ---- PostgreSQL (Supabase Cloud) ----
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_database_password
DB_NAME=postgres

# ---- Đăng nhập ----
JWT_SECRET=thay_bang_chuoi_bi_mat_dai_va_ngau_nhien
JWT_EXPIRES_IN=4.5h
JWT_REFRESH_EXPIRES_IN=7d

# ---- RabbitMQ (Production Mode / Optional) ----
RABBITMQ_URL=

# ---- Crawler Services ----
GOOGLE_CRAWLER_URL=http://localhost:8000
FACEBOOK_CRAWLER_URL=http://localhost:8001

# ---- Webhooks ----
BACKEND_PUBLIC_URL=http://localhost:3001
CRAWLER_WEBHOOK_SECRET=change-this-to-random-secret-key

# ---- Auto Crawler Trigger ----
ENABLE_AUTO_CRAWL=false

# Google OAuth 2.0 Credentials (Bổ sung nếu cần sử dụng Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

FRONTEND_URL=http://localhost:3000

OFFICIAL_EMAIL_DOMAINS=syt.com,syt.gov.vn,ca.gov.vn



