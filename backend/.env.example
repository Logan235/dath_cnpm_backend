# ---- Tùy chọn ----
# Cổng backend (mặc định 3001)
# PORT=3001
# Đuôi email cơ quan dự phòng (ưu tiên tham số OFFICIAL_EMAIL_DOMAINS trong database)
# OFFICIAL_EMAIL_DOMAINS=syt.com,syt.gov.vn,ca.gov.vn
# Địa chỉ API mô hình AI thật. Bỏ trống = dùng bộ AI rule-based tích hợp sẵn.
# API nhận POST {"text": "..."} và trả {"confidence": 0.9, "violationTypes": ["FALSE_CLAIM"], "explanation": "..."}
# AI_SERVICE_URL=http://localhost:8000/analyze
