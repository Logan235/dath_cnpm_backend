# Sao chép file này thành ".env" rồi sửa cho đúng máy của bạn
# (Windows PowerShell: copy .env.example .env)

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=do_an_tong_hop
DB_PASSWORD=@Trung2006
# Tên database (npm run db:setup sẽ tự tạo nếu chưa có)
DB_NAME=ad_monitoring

# ---- Đăng nhập ----
JWT_SECRET=thay_bang_chuoi_bi_mat_dai_va_ngau_nhien
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---- RabbitMQ (Production Mode) ----
# URL RabbitMQ server. Nếu bỏ trống: AI sẽ dùng built-in rule-based (sync mode)
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# ---- Crawler Services ----
# URLs của các crawler services (để trigger crawl jobs)
GOOGLE_CRAWLER_URL=http://localhost:8000
FACEBOOK_CRAWLER_URL=http://localhost:8001

# ---- Webhooks ----
# Public URL của Backend (để crawler gọi webhook callback)
BACKEND_PUBLIC_URL=http://localhost:3001
# Secret key để verify webhook từ crawler (random 32+ characters)
CRAWLER_WEBHOOK_SECRET=change-this-to-random-secret-key

# ---- Auto Crawler Trigger ----
# true = Tự động trigger crawler theo schedule mỗi giờ
# false = Chỉ trigger thủ công từ UI (khuyến nghị ban đầu)
ENABLE_AUTO_CRAWL=false

# ---- Tùy chọn ----
# Cổng backend (mặc định 3001)
# PORT=3001
# Đuôi email cơ quan dự phòng (ưu tiên tham số OFFICIAL_EMAIL_DOMAINS trong database)
# OFFICIAL_EMAIL_DOMAINS=syt.com,syt.gov.vn,ca.gov.vn
# Địa chỉ API mô hình AI thật (legacy - không cần nữa khi dùng RabbitMQ)
# AI_SERVICE_URL=http://localhost:8000/analyze

